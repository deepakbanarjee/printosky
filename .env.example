# =============================================================================
# Printosky .env template
# =============================================================================
# Copy this file to .env and fill in the values. The install/bootstrap.ps1
# installer copies this file automatically and rotates the per-store keys.
#
# Three groups: REQUIRED on every store PC, OPTIONAL, and VERCEL-ONLY
# (= set in the Vercel dashboard, not in this file).
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED on every store PC
# -----------------------------------------------------------------------------

# Supabase API (shared across all stores). Get from the Supabase dashboard:
#   Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx

# Supabase Auth service account (create once in Authentication -> Users):
SUPABASE_AUTH_EMAIL=admin@printosky.internal
SUPABASE_AUTH_PASSWORD=YourStrongPasswordHere

# Per-store auth token (UNIQUE per store; the installer auto-generates a
# fresh 64-hex value via cryptographic RNG, no need to fill in manually):
STORE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Epson EM-C8100 web admin credentials (LAN-only printer; used by
# printer_poller.py and epson_jobs_fetcher.py). UNIQUE per store/printer.
EPSON_USER=Oxygen
EPSON_PASS=your_epson_web_admin_password
# Optional: extra passwords epson_jobs_fetcher.py tries if EPSON_PASS fails
# (comma-separated, tried in order). Use for units whose admin password is the
# device serial, or during a password rotation. Leave blank if not needed.
EPSON_PASS_FALLBACKS=
# Optional: usernames tried against each password (comma-separated; a blank
# entry means "no username"). Defaults to ",Oxygen,admin" when unset.
EPSON_USERS=

# Anthropic API key (used by docx_engine.py for format-fix LLM calls).
# Get a key from https://console.anthropic.com. Same key can be reused
# across all stores - it's not per-store.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# OPTIONAL (have sensible defaults if omitted)
# -----------------------------------------------------------------------------

# Anthropic model overrides (default to the latest models in docx_engine.py):
# ANTHROPIC_MODEL_OPUS=claude-opus-4-5-20251101
# ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6-20251201

# Academic-pipeline worker poll interval in seconds (default 30):
# ACAD_POLL_INTERVAL=30

# Store's own WhatsApp number (with country code, no +). Used only when this
# store's daemon needs to identify itself in cross-store routing.
# STORE_WHATSAPP_PHONE=919495706405


# -----------------------------------------------------------------------------
# VERCEL-ONLY (do NOT put these in this file - set them in Vercel dashboard
# at https://vercel.com -> printosky project -> Settings -> Environment Variables)
# -----------------------------------------------------------------------------
#
# The api/index.py serverless function on Vercel reads these. The store-PC
# scripts (watcher.py, print_server.py, academic_pipeline_worker.py, etc.)
# do NOT read any of these.
#
#   ADMIN_PASSWORD_HASH       (sha256 of admin password; HMAC-validated by api/index.py)
#   META_APP_SECRET           (Meta dev portal -> Settings -> Basic)
#   META_WEBHOOK_VERIFY_TOKEN (string you choose; must match Meta webhook config)
#   META_SYSTEM_USER_TOKEN    (Meta dev portal -> System Users -> generate token)
#   META_PHONE_NUMBER_ID      (Meta dev portal -> WhatsApp -> Phone Numbers)
#   RAZORPAY_KEY_ID           (Razorpay dashboard -> Settings -> API Keys)
#   RAZORPAY_KEY_SECRET       (same)
#   RAZORPAY_WEBHOOK_SECRET   (Razorpay dashboard -> Webhooks)
#
# If you've been carrying any of these in past store-PC .env files, you can
# leave them - they're harmless overhead, just not needed.
